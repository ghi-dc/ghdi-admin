{
    "config": {
        "platform": {
            "php": "8.4.1"
        },
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/ghi-dc/exist-db-rpc-client"
        },
        {
            "type": "vcs",
            "url": "https://github.com/burki/SolrBundle"
        },
        {
            "type": "vcs",
            "url": "https://github.com/Donkfather/zotero-api"
        },
        {
            "type": "vcs",
            "url": "https://github.com/burki/scssphp-bundle"
        },
        {
            "type": "vcs",
            "url": "https://github.com/burki/FluentDOM"
        },
        {
            "type": "vcs",
            "url": "https://github.com/lstrojny/fxmlrpc"
        },
        {
            "type": "vcs",
            "url": "https://github.com/burki/JMSTranslationBundle"
        }
    ],
    "require": {
        "php": ">=8.4.1",
        "ext-ctype": "*",
        "ext-exif": "*",
        "ext-iconv": "*",
        "ext-intl": "*",

        "symfony/config": "^8.1",
        "symfony/finder": "^8.1",
        "symfony/filesystem": "^8.1",
        "symfony/yaml": "^8.1",
        "symfony/expression-language": "^8.1",
        "symfony/console": "^8.1",
        "symfony/process": "^8.1",
        "symfony/framework-bundle": "^8.1",

        "symfony/http-foundation": "^8.1",
        "symfony/event-dispatcher": "^8.1",
        "symfony/cache": "^8.1",
        "symfony/routing": "^8.1",
        "jms/translation-bundle": "dev-symfony-8",

        "symfony/property-access": "^8.1",
        "symfony/options-resolver": "^8.1",

        "symfony/translation": "^8.1",
        "twig/twig": "^3.29",
        "twig/markdown-extra": "^3.29",
        "erusev/parsedown": "^1.8",
        "twig/extra-bundle": "^3.29",
        "jasny/twig-extensions": "^1.3",
        "symfony/twig-bridge": "^8.1",
        "symfony/twig-bundle": "^8.1",

        "symfony/security-core": "^8.1",
        "symfony/security-http": "^8.1",
        "symfony/security-csrf": "^8.1",
        "symfony/security-bundle": "^8.1",

        "symfony/intl": "^8.1",
        "symfony/form": "^8.1",
        "symfony/validator": "^8.1",
        "ninsuo/symfony-collection": "^2.1",

        "symfony/monolog-bundle": "^4.0",
        "symfony/monolog-bridge": "^8.1",

        "symfony/asset": "^8.1",
        "armin/scssphp-bundle": "dev-master",

        "symfony/mime": "^8.1",
        "symfony/dom-crawler": "^8.1",
        "symfony/css-selector": "^8.1",

        "symfony/http-client": "^8.1",

        "knplabs/knp-menu-bundle": "^3.8",

        "symfony/web-profiler-bundle": "^8.1",
        "symfony/debug-bundle": "^8.1",
        "symfony/var-dumper": "^8.1",

        "jms/serializer-bundle": "^5.5",

        "league/iso3166": "^4.4",

        "mpdf/mpdf": "^8.3",

        "sabre/xml": "^4.1",
        "servo/fluidxml": "^2.0",
        "fluentdom/fluentdom": "dev-main as 8.0",
        "brunty/relax-ng-domdocument": "^0.2",

        "masterminds/html5": "^2.11",
        "symfony/string": "^8.1",

        "hedii/zotero-api": "dev-master#c296090",

        "seboettg/citeproc-php": "^2.6",
        "fale/isbn": "^3.1",

        "sweetrdf/easyrdf": "^1.19",
        "ml/json-ld": "^1.2",

        "ghi-dc/exist-db-rpc-client": "dev-psr17",
        "lstrojny/fxmlrpc": "dev-master#e90f9818dfe074a6ea49aee302d9911645f18d3c",

        "cocur/slugify": "^4.7",

        "trisoftro/collective-access-client": "dev-master#11b5d53",
        "ezyang/htmlpurifier": "^4.19",
        "asika/autolink": "^1.1",
        "voku/html-min": "^5.0",
        "imagine/imagine": "^1.5",

        "textrazor/textrazor-php": "*@dev",

        "nategood/httpful": "^1.0",
        "openspout/openspout": "^5.12",
        "phpoffice/phpword": "^0.18",

        "symfony/polyfill-intl-normalizer": "^1.43",

        "boppy/solr-bundle": "dev-attributes-only",
        "doctrine/collections": "^3.1"
    },
    "replace": {
        "paragonie/random_compat": "2.*",
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php80": "*",
        "symfony/polyfill-php81": "*",
        "symfony/polyfill-php82": "*",
        "symfony/polyfill-php83": "*",
        "symfony/polyfill-php84": "*"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpstan/phpstan": "^2.2"
    }
}
